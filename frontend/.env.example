# Copy to `.env.local` only when running the Next.js frontend outside Docker.
# Docker Compose derives these values from the root `.env` instead.

# Backend URL for server-side Next.js rewrites.
API_URL=http://localhost:8080

# Browser-visible backend URL for REST and Socket.IO.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# Optional Next.js subpath. Leave empty when serving at the domain root.
NEXT_PUBLIC_BASE_PATH=/chess
