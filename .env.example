# Copy this file to `.env` and replace every placeholder before deployment.
# Never commit the real `.env` file.

# Backend server (use 8080 for local Windows development; use 80 if your VPS requires it).
PORT=8080
MONGO_URI=mongodb://localhost:27017/chess
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Exact browser origins allowed to access REST and Socket.IO, separated by commas.
CORS_ORIGINS=http://localhost:3000
VERCEL_WEB=http://localhost:3000

# MQTT broker credentials.
URL_HIVEMQTT=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_PORT=8883

# Docker Compose frontend build settings. One public origin is compiled into
# both browser API and Socket.IO URLs. Leave FRONTEND_BASE_PATH empty at `/`.
FRONTEND_BASE_PATH=/chess
BACKEND_PUBLIC_URL=http://your-domain.example

# Optional backend settings.
# SERVER_NAME=ChessServer
# MQTT_TOPIC_GET_IP=chess/get-ip
# MONGO_LOCAL=true
