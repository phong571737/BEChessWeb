# Copy this file to `.env` and replace every placeholder before deployment.
# Never commit the real `.env` file.

# Backend server (use 8080 for local Windows development; use 80 if your VPS requires it).
PORT=8080
MONGO_URI=mongodb://localhost:27017/chess
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Exact browser origins allowed to access REST and Socket.IO, separated by commas.
CORS_ORIGINS=http://localhost:3000
VERCEL_WEB=http://localhost:3000

# MQTT broker credentials.
URL_HIVEMQTT=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_PORT=8883

# Docker Compose frontend build settings. One public origin is compiled into
# both browser API and Socket.IO URLs. Leave FRONTEND_BASE_PATH empty at `/`.
FRONTEND_BASE_PATH=/chess
BACKEND_PUBLIC_URL=http://your-domain.example
# Internal Docker URLs used by Compose; set these to the service addresses in your deployment.
BACKEND_INTERNAL_URL=http://backend-service-name:backend-port
RECOVER_SERVICE_URL=http://recovery-service-name:recovery-port
# Maximum time the backend waits for one recovery request (milliseconds).
RECOVERY_TIMEOUT_MS=60000
# Keep the Python work budget below the backend HTTP timeout (includes cleanup).
RECOVERY_WORKER_TIMEOUT_SECONDS=50
RECOVERY_CONCURRENCY=2

# Stockfish recommendation API. The host port is loopback-only and Nginx
# publishes the service under /stockfish-api/ on the website origin.
STOCKFISH_RECOMMEND_PORT=8001
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128
STOCKFISH_ANALYSIS_TIMEOUT_SECONDS=3
STOCKFISH_ENGINE_STOP_GRACE_SECONDS=1
STOCKFISH_STARTUP_TIMEOUT_SECONDS=10
STOCKFISH_READINESS_TIMEOUT_SECONDS=1
STOCKFISH_QUEUE_WAIT_TIMEOUT_SECONDS=5
STOCKFISH_MAX_DEPTH=20
STOCKFISH_QUEUE_SIZE=8
STOCKFISH_MAX_REQUEST_BODY_BYTES=2048

# Optional backend settings.
# SERVER_NAME=ChessServer
# MQTT_TOPIC_GET_IP=chess/get-ip
# MONGO_LOCAL=true

# Optional bootstrap accounts. Use deployment secrets for real credentials.
ADMIN_USERNAME=developer-admin
ADMIN_EMAIL=developer-admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-high-entropy-admin-password
USER_USERNAME=user
USER_EMAIL=user@example.com
USER_PASSWORD=replace-with-a-user-password
