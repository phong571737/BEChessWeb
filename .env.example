# ── Required ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── Optional (default shown) ──────────────────────────────────────────────────

# Port exposed on host (nginx reverse proxy)
APP_PORT=80

# CORS — must match the URL users open in browser (dev default: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# Socket.IO fallback (only needed if auto-discovery from window.location doesn't work)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
